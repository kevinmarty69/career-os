DATABASE_URL=postgresql://career_os:career_os@localhost:54329/career_os
# This public repository implements self-hosting only.
CAREER_OS_DEPLOYMENT_MODE=self-hosted
# Public origin used for authentication callbacks and mutation origin checks.
BETTER_AUTH_URL=http://localhost:3000
# Generate locally with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Required for a complete self-hosted workflow. Only loopback OpenAI-compatible endpoints are
# accepted in the current canary; no remote or paid provider can be enabled.
# Give every worker URL a different login that belongs only to its matching role.
CAREER_OS_WORKER_DATABASE_URL=
CAREER_OS_EVIDENCE_WORKER_DATABASE_URL=
CAREER_OS_STRATEGY_WORKER_DATABASE_URL=
CAREER_OS_PAGE_COMPOSER_DATABASE_URL=
# Build with `docker build -f Dockerfile.page-composer -t career-os-page-composer:local .`.
# Managed deployments must use an immutable `registry/image@sha256:...` reference.
CAREER_OS_PAGE_COMPOSER_IMAGE=career-os-page-composer:local
CAREER_OS_RECRUITER_REVIEWER_DATABASE_URL=
CAREER_OS_HIRING_MANAGER_REVIEWER_DATABASE_URL=
CAREER_OS_FACTUALITY_REVIEWER_DATABASE_URL=
CAREER_OS_LOCAL_MODEL_BASE_URL=http://127.0.0.1:11434/v1
CAREER_OS_LOCAL_MODEL_API_KEY=local-only
CAREER_OS_LOCAL_MODEL=
