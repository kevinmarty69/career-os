# Optional Supabase-hosted PostgreSQL settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://career_os:career_os@localhost:54329/career_os
# Public origin used for authentication callbacks and mutation origin checks.
BETTER_AUTH_URL=http://localhost:3000
# Generate locally with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The deterministic fake is the default. Network calls remain disabled unless
# every opt-in and explicit pricing field below is set by a trusted server.
CAREER_OS_AGENT_PROVIDER=fake
CAREER_OS_ALLOW_NETWORK_PROVIDER=false
CAREER_OS_ALLOW_REMOTE_PROVIDER=false
CAREER_OS_OPENAI_BASE_URL=http://127.0.0.1:11434/v1
CAREER_OS_OPENAI_API_KEY=
CAREER_OS_OPENAI_MODEL=
CAREER_OS_INPUT_COST_MICROS_PER_MILLION=
CAREER_OS_OUTPUT_COST_MICROS_PER_MILLION=
