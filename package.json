{
  "name": "career-os",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/unit/*.test.ts",
    "benchmark:mvp": "tsx scripts/benchmark-mvp.ts",
    "test:load": "pnpm benchmark:mvp && pnpm test:integration:discovery-concurrency && node --import tsx supabase/tests/durable-step-concurrency.mjs",
    "test:integration:worker": "NODE_OPTIONS=--conditions=react-server tsx --test --test-concurrency=1 tests/integration/*worker.test.ts",
    "test:integration:correction": "NODE_OPTIONS=--conditions=react-server tsx --test --test-concurrency=1 tests/integration/page-correction-worker.test.ts",
    "test:integration:export": "NODE_OPTIONS=--conditions=react-server tsx --test --test-concurrency=1 tests/integration/workspace-*.test.ts",
    "test:integration:discovery-concurrency": "node --import tsx supabase/tests/scheduled-discovery-concurrency.mjs",
    "test:integration:http": "node scripts/run-http-integration-tests.mjs",
    "test:security": "tsx --test tests/unit/safe-http.test.ts tests/unit/profile-import.test.ts tests/unit/publication-security.test.ts && pnpm db:test && pnpm test:integration:http",
    "test:accessibility": "playwright test tests/e2e/accessibility.spec.ts --project=chromium --project=mobile",
    "worker": "tsx scripts/run-agent-worker.ts",
    "worker:company-researcher": "tsx scripts/run-agent-worker.ts",
    "worker:evidence": "tsx scripts/run-evidence-worker.ts",
    "worker:evidence-archivist": "tsx scripts/run-evidence-worker.ts",
    "worker:strategy": "tsx scripts/run-strategy-worker.ts",
    "worker:recruiter-strategist": "tsx scripts/run-strategy-worker.ts",
    "worker:page": "tsx scripts/run-page-composer-worker.ts",
    "worker:page-composer": "tsx scripts/run-page-composer-worker.ts",
    "worker:job-discovery": "NODE_OPTIONS=--conditions=react-server tsx scripts/run-discovery-worker.ts",
    "worker:review:recruiter": "CAREER_OS_REVIEWER=recruiter tsx scripts/run-reviewer-worker.ts",
    "worker:recruiter-reviewer": "CAREER_OS_REVIEWER=recruiter tsx scripts/run-reviewer-worker.ts",
    "worker:review:hiring-manager": "CAREER_OS_REVIEWER=hiring-manager tsx scripts/run-reviewer-worker.ts",
    "worker:hiring-manager-reviewer": "CAREER_OS_REVIEWER=hiring-manager tsx scripts/run-reviewer-worker.ts",
    "worker:review:factuality": "CAREER_OS_REVIEWER=factuality tsx scripts/run-reviewer-worker.ts",
    "worker:factuality-reviewer": "CAREER_OS_REVIEWER=factuality tsx scripts/run-reviewer-worker.ts",
    "test:e2e": "pnpm build && playwright test --project=chromium && playwright test --project=mobile",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "db:test:migration": "node --import tsx supabase/tests/application-migration.mjs",
    "db:test": "node --import tsx scripts/run-database-tests.mjs",
    "test:integration:semantic": "NODE_OPTIONS=--conditions=react-server tsx --test tests/integration/semantic-analyses.test.ts",
    "test:native": "node scripts/native-test-stack.mjs",
    "verify:persisted": "pnpm db:test && pnpm test:integration:export && pnpm test:integration:semantic && pnpm test:integration:worker && pnpm build && pnpm test:integration:http"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.115.0",
    "clsx": "^2.1.1",
    "mammoth": "1.12.2",
    "next": "16.3.4",
    "pg": "8.23.0",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.6.0",
    "tsx": "4.23.13",
    "unpdf": "1.8.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.4",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@11.24.0"
}
